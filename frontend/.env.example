# Public site URL used for canonical links / SEO (no secrets in frontend env files)
VITE_SITE_URL=https://example.com

# Optional: base URL of the Laravel API. Leave unset to keep the UI in demo mode.
# VITE_API_URL=http://localhost:8000/api

# Optional: base URL for the tools API (e.g. business-name generator).
# VITE_TOOLS_API_URL=http://localhost:8000/api
